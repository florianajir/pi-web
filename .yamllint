extends: default

yaml-files:
  - "*.yaml"
  - "*.yml"

yaml-tags:
  - "!reset"

rules:
  line-length:
    max: 120
    level: warning
  # Tracked files are split on a leading `---`: homepage's configs and the
  # Cardigann indexer definition carry one because upstream's examples do,
  # compose.yaml and the workflows do not. Enforcing either side would churn
  # files for no gain.
  document-start: disable
  truthy: disable
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
