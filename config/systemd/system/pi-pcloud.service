[Unit]
Description=Pi-pcloud
Requires=docker.service
After=network-online.target docker.service
# Long-lived side services started/stopped with the stack (PartOf on their side).
Wants=pi-pcloud-authelia-ntfy.service

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_PATH__
# Back-compat default for installs whose .env predates per-service profiles
# (no COMPOSE_PROFILES line): enable everything. A COMPOSE_PROFILES line in
# .env overrides this (EnvironmentFile= wins over Environment=).
Environment=COMPOSE_PROFILES=all
EnvironmentFile=__PROJECT_PATH__/.env
ExecStartPre=-/usr/sbin/ethtool -K eth0 rx-udp-gro-forwarding on rx-gro-list off
# The whole start sequence — pre-start hooks, `docker compose up -d`, then the
# bootstraps — lives in one script rather than in twenty Exec* lines, so that
# `make update` can re-run exactly what boot runs without stopping the stack
# first. The script keeps the semantics these lines had: a pre-start hook that
# fails aborts the start, a bootstrap that fails only warns.
ExecStart=/bin/sh __PROJECT_PATH__/scripts/stack-up.sh
ExecStop=/usr/bin/docker compose down --remove-orphans
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
