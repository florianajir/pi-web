# Copy this file to homepage.env and fill in the keys/credentials you have.
# Names MUST keep the HOMEPAGE_VAR_ prefix - that's how Homepage's
# {{HOMEPAGE_VAR_x}} label templating finds them; env_file loads variable
# names as-is, so a name without the prefix is invisible to it.
#
# An empty/missing value just leaves that service's dashboard card as a plain
# link (small error icon instead of live stats) - it doesn't break anything.
#
# After editing, restart Homepage to apply: docker compose restart homepage

# Immich: Account Settings > API Keys (create one with the "server.statistics" permission)
HOMEPAGE_VAR_IMMICH_API_KEY=

# Kavita: an API key, not a login. The OIDC config disables password auth, and
# only apiKey logins are exempt. Kavita UI > Settings > Account > API Key.
HOMEPAGE_VAR_KAVITA_API_KEY=
