# Rendered to config.yml by scripts/cloudflared-pre-start.sh. Edit this file,
# never the rendered one - that is gitignored and rewritten on every start.
#
# Only hostnames meant to be reachable from the internet appear below, and the
# catch-all answers 404 for everything else. That is deliberate belt and braces:
# a stray or mistaken DNS record cannot reach a service that has no rule here.
#
# NEVER add a wildcard hostname. cloudflared reaches Traefik from the `tunnel`
# network, whose subnet sits outside ALLOW_IP_RANGES on purpose, so requests
# arrive at an address lan@docker rejects and only the `-public` routers can
# answer. A wildcard would hand that same path to every gated service, and the
# rejection would be silent.
tunnel: __TUNNEL_ID__
credentials-file: /etc/cloudflared/credentials.json

# Bound inside the container only, never published. Kept so the tunnel's health
# can be read from `frontend` later without opening anything to the host.
metrics: 0.0.0.0:2000

originRequest:
  # Traefik routes on the Host header, which cloudflared preserves; this only
  # sets the SNI so the origin's TLS certificate validates. The wildcard cert
  # carries the apex as its main domain, so the bare HOST_NAME is what matches.
  originServerName: __HOST_NAME__

ingress:
  # Authelia has to stay publicly reachable: registering a device off-tailnet
  # starts at headscale and redirects here for the OIDC login.
  - hostname: auth.__HOST_NAME__
    service: https://pi-traefik:443

  # Public share links only. The routers behind these two hostnames were
  # narrowed so the authenticated API stays behind lan@docker.
  - hostname: immich.__HOST_NAME__
    service: https://pi-traefik:443

  - hostname: nextcloud.__HOST_NAME__
    service: https://pi-traefik:443

  # Control plane only. WireGuard itself never comes through here - it is
  # peer-to-peer on 41641/udp, which a tunnel cannot carry anyway.
  - hostname: headscale.__HOST_NAME__
    service: https://pi-traefik:443

  - service: http_status:404
